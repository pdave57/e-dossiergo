# ─── Server ───────────────────────────────────────────────────────────────────
PORT=
APP_ENV=# development | production
READ_TIMEOUT=
WRITE_TIMEOUT=
IDLE_TIMEOUT=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=
DB_MAX_OPEN_CONNS=
DB_MAX_IDLE_CONNS=
DB_CONN_MAX_LIFE=

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL=      # 7 days

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info               # debug | info | warn | error
